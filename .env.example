# ────────────────────────────────────────────────
# Database
# ────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sobok?schema=public"

# ────────────────────────────────────────────────
# JWT
# ────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key
JWT_ACCESS_EXPIRY=86400       # 1일 (초)
JWT_REFRESH_EXPIRY=2592000    # 30일 (초)

# ────────────────────────────────────────────────
# OAuth
# ────────────────────────────────────────────────
APPLE_CLIENT_ID=com.your.app.bundle.id

# ────────────────────────────────────────────────
# Redis (SMS 인증코드 저장)
# ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password   # 없으면 빈 값으로 둠

# ────────────────────────────────────────────────
# CoolSMS (문자 인증)
# ────────────────────────────────────────────────
COOLSMS_API_KEY=your_coolsms_api_key
COOLSMS_API_SECRET=your_coolsms_api_secret
COOLSMS_FROM_NUMBER=01000000000      # 발신자 번호 (숫자만)

# ────────────────────────────────────────────────
# Firebase (FCM 푸시 알림)
# ────────────────────────────────────────────────
# Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성 → JSON 다운로드

# [방법 1] 파일 경로 지정 (권장) — secrets/ 폴더에 JSON 파일을 두고 경로를 지정
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json

# [방법 2] 인라인 JSON 문자열 — CI/CD 환경 등에서 파일 사용이 어려울 때
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your_project_id",...}

# ────────────────────────────────────────────────
# OpenAI (AI 루틴 추천)
# ────────────────────────────────────────────────
OPENAI_API_KEY=sk-your_openai_api_key

#cloud-config

package_update: true
package_upgrade: true

runcmd:
  # --- EPEL (certbot 등 추가 패키지용) ---
  - dnf install -y oracle-epel-release-el9

  # --- 기본 패키지 ---
  - dnf install -y nginx git firewalld python3-pip

  # --- Certbot (pip) ---
  - pip3 install certbot certbot-nginx

  # --- Node.js 22 LTS (ARM64) ---
  - curl -fsSL https://rpm.nodesource.com/setup_22.x | bash -
  - dnf install -y nodejs

  # --- pnpm ---
  - npm install -g pnpm@10

  # --- Redis ---
  - dnf install -y redis
  - "sed -i 's/^bind .*/bind 127.0.0.1/' /etc/redis/redis.conf || true"
  - "sed -i 's/^appendonly .*/appendonly yes/' /etc/redis/redis.conf || true"
  - systemctl enable --now redis

  # --- SELinux: allow Nginx to proxy ---
  - setsebool -P httpd_can_network_connect 1

  # --- Firewall ---
  - systemctl enable --now firewalld
  - firewall-cmd --permanent --add-service=ssh
  - firewall-cmd --permanent --add-service=http
  - firewall-cmd --permanent --add-service=https
  - firewall-cmd --reload

  # --- Nginx config ---
  - rm -f /etc/nginx/conf.d/default.conf
  - |
    cat > /etc/nginx/conf.d/sobok.conf << 'NGINX'
    server {
        listen 80;
        server_name ${domain};

        location / {
            proxy_pass http://127.0.0.1:3000;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }
    }
    NGINX
  - systemctl enable --now nginx

  # --- Systemd service ---
  - |
    cat > /etc/systemd/system/sobok.service << 'SERVICE'
    [Unit]
    Description=Sobok NestJS Application
    After=network.target redis.service
    Wants=redis.service

    [Service]
    Type=simple
    User=sobok
    Group=sobok
    WorkingDirectory=/opt/sobok/current
    Environment=NODE_ENV=production
    EnvironmentFile=-/opt/sobok/.env
    ExecStart=/usr/bin/node dist/main
    Restart=always
    RestartSec=5

    [Install]
    WantedBy=multi-user.target
    SERVICE

  # --- App user & directories ---
  - useradd -r -s /usr/sbin/nologin -d /opt/sobok sobok
  - mkdir -p /opt/sobok/releases
  - "chown sobok:sobok /opt/sobok/.env 2>/dev/null || true"

  # --- Allow opc and sobok to restart sobok service without password ---
  - |
    cat > /etc/sudoers.d/sobok << 'SUDOERS'
    opc ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart sobok, /usr/bin/systemctl stop sobok, /usr/bin/systemctl start sobok
    sobok ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart sobok, /usr/bin/systemctl stop sobok, /usr/bin/systemctl start sobok
    SUDOERS
  - chmod 440 /etc/sudoers.d/sobok

  # --- Deploy script ---
  - |
    cat > /opt/sobok/deploy.sh << 'DEPLOY'
    #!/bin/bash
    set -euo pipefail

    DEPLOY_DIR="/opt/sobok"
    TARBALL="$1"
    TIMESTAMP=$(date +%Y%m%d_%H%M%S)
    RELEASE_DIR="$${DEPLOY_DIR}/releases/$${TIMESTAMP}"

    if [ -z "$${TARBALL:-}" ]; then
      echo "Usage: deploy.sh <tarball-path>"
      exit 1
    fi

    echo "==> Deploying release $${TIMESTAMP}"
    mkdir -p "$${RELEASE_DIR}"
    tar -xzf "$${TARBALL}" -C "$${RELEASE_DIR}"

    cd "$${RELEASE_DIR}"
    npm install --omit=dev --ignore-scripts 2>/dev/null || /usr/local/bin/pnpm install --prod --frozen-lockfile
    npx prisma generate

    ln -sfn "$${RELEASE_DIR}" "$${DEPLOY_DIR}/current"
    sudo systemctl restart sobok

    cd "$${DEPLOY_DIR}/releases"
    ls -1dt */ | tail -n +4 | xargs -r rm -rf

    echo "==> Deploy complete: $${TIMESTAMP}"
    DEPLOY
  - chmod 755 /opt/sobok/deploy.sh
  - chown -R sobok:sobok /opt/sobok

  # --- Enable sobok service ---
  - systemctl daemon-reload
  - systemctl enable sobok

  # --- Vector (BetterStack log agent) ---
  - curl -1sLf 'https://repositories.timber.io/public/vector/cfg/setup/bash.rpm.sh' | bash
  - dnf install -y vector
  - |
    cat > /etc/vector/vector.toml << 'VECTOR'
    [sources.journald]
    type = "journald"
    current_boot_only = false
    units = ["sobok.service", "nginx.service"]

    [sinks.betterstack]
    type = "http"
    inputs = ["journald"]
    uri = "https://in.logs.betterstack.com"
    encoding.codec = "json"

    [sinks.betterstack.auth]
    strategy = "bearer"
    token = "${betterstack_token}"
    VECTOR
  - systemctl enable --now vector

  # --- SSL certificate (auto, DNS 전파 완료 전제) ---
  - /usr/local/bin/certbot --nginx -d ${domain} --non-interactive --agree-tos -m ${certbot_email}
